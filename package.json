{
  "name": "remote-presenter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rsbuild build",
    "check": "biome check --write",
    "dev": "rsbuild",
    "dev:worker": "node scripts/dev-worker.mjs",
    "dev:full": "pnpm run build && pnpm run dev:worker",
    "deploy": "pnpm run build && wrangler deploy --env \"\"",
    "deploy:staging": "pnpm run build && wrangler deploy --env staging",
    "deploy:dry": "pnpm run build && wrangler deploy --env \"\" --dry-run",
    "types": "wrangler types",
    "typecheck": "pnpm run types && tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint": "biome check .",
    "format": "biome format --write",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:workers": "vitest run --config vitest.worker.config.ts",
    "test:browser": "playwright test",
    "test:watch": "rstest --watch"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "@noble/hashes": "2.4.0",
    "hono": "4.13.14",
    "jszip": "3.10.2",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "^2.2.14",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/adapter-rsbuild": "^0.12.3",
    "@rstest/core": "^0.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "happy-dom": "^20.14.6",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
